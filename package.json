{
  "name": "fhg-command",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --local --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply fhg-command-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fhg-command-db --remote",
    "deploy:api": "wrangler deploy",
    "deploy:web": "wrangler pages deploy dist --project-name fhg-command",
    "test": "node --test"
  },
  "devDependencies": {
    "vite": "7.3.6",
    "wrangler": "4.127.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
